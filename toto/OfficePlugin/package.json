{
  "name": "officeplugin-react-addin",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Office Add-in built with React, TypeScript, and Office SSO.",
  "scripts": {
    "start": "vite --port 4200",
    "dev": "vite --port 4200",
    "build": "vite build",
    "preview": "vite preview --port 4200",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs,.mjs --max-warnings=0",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@microsoft/office-js": "^1.1.110",
    "@types/office-js": "^1.0.64",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.4.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
